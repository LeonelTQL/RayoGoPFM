{
  "info": {
    "_postman_id": "f5831f20-07d1-4de3-8be9-7d279d34f603",
    "name": "Smart Delivery API - Flujo de Negocio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "password", "value": "SecurePass1!VerySecurePassphraseWithLength60OrMore" }
  ],
  "item": [
    {
      "name": "01 Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('API operativa', () => pm.response.to.have.status(200));",
        "pm.test('Estado ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
      ] } }]
    },
    {
      "name": "02 Registro Cliente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Leonel Cliente\",\"email\":\"{{clientEmail}}\",\"password\":\"{{password}}\",\"phone\":\"+593999999992\"}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('clientEmail', `cliente.${Date.now()}@smartdelivery.com`);"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Registro exitoso', () => pm.response.to.have.status(201));",
          "const json = pm.response.json();",
          "pm.collectionVariables.set('clientToken', json.token);",
          "pm.collectionVariables.set('clientId', json.user.id);",
          "pm.expect(json.user.role).to.eql('cliente');"
        ] } }
      ]
    },
    {
      "name": "03 Login Cliente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{clientEmail}}\",\"password\":\"{{password}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login exitoso', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.collectionVariables.set('clientToken', json.token);"
      ] } }]
    },
    {
      "name": "04 Perfil de Usuario",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{clientToken}}" }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Obtener perfil exitoso', () => pm.response.to.have.status(200));",
        "pm.test('Validar email', () => pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('clientEmail')));"
      ] } }]
    },
    {
      "name": "05 Obtener Categorias",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Categorias obtenidas', () => pm.response.to.have.status(200));"
      ] } }]
    },
    {
      "name": "06 Obtener Productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Productos obtenidos', () => pm.response.to.have.status(200));"
      ] } }]
    }
  ]
}
