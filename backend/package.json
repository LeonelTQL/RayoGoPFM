{
  "name": "smart-delivery-backend",
  "version": "1.0.0",
  "description": "Backend REST para Smart Delivery con Express y PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "delivery",
    "node",
    "express",
    "postgres",
    "flutter"
  ],
  "author": "Smart Delivery Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/",
      "src/server.js",
      "src/config/socket.js",
      "src/config/upload.js",
      "scripts/",
      "database/"
    ],
    "collectCoverageFrom": [
      "src/middlewares/*.js",
      "src/utils/*.js",
      "src/routes/*.js",
      "src/modules/auth/**/*.js",
      "src/modules/categories/**/*.js",
      "src/modules/products/**/*.js",
      "src/modules/addresses/**/*.js",
      "src/app.js"
    ]
  }
}
